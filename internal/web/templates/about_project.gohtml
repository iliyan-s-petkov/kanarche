{{/* /about: what the project is. Static prose plus two islands (the privacy
     clear button and the visitors chart), and it renders with no snapshot, so
     it may not read .Areas or .Area. */}}
{{define "main"}}
<div class="measure about-page">
<div class="page-head">
  <img class="about-mascot" src="{{.Static "kanarche-mascot.svg"}}" data-logo="kanarche-1b-mascot" width="200" height="200" alt="{{.T "about.mascot.alt"}}">
  <h1 class="t-title">{{.T "about.page.title"}}</h1>
  <p class="t-body">{{.T "about.page.intro"}}</p>
  <nav class="about-toc" aria-label="{{.T "about.toc.label"}}">
    <a href="#goals">{{.T "about.toc.goals"}}</a>
    <a href="#start">{{.T "about.start.heading"}}</a>
    <a class="about-toc__sub" href="#start-read">{{.T "about.start.group.read.title"}}</a>
    <a class="about-toc__sub" href="#start-find">{{.T "about.start.group.find.title"}}</a>
    <a class="about-toc__sub" href="#start-move">{{.T "about.start.group.move.title"}}</a>
    <a class="about-toc__sub" href="#start-layers">{{.T "about.start.group.layers.title"}}</a>
    <a class="about-toc__sub" href="#start-history">{{.T "about.start.group.history.title"}}</a>
    <a class="about-toc__sub" href="#start-keep">{{.T "about.start.group.keep.title"}}</a>
    <a href="#privacy">{{.T "about.privacy.heading"}}</a>
    <a href="#visitors">{{.T "about.visitors.heading"}}</a>
    <a href="#station">{{.T "about.station.heading"}}</a>
    <a href="#involved">{{.T "about.involved.heading"}}</a>
    <a href="#more">{{.T "about.toc.more"}}</a>
  </nav>
</div>

<section class="about-section about-section--first" aria-labelledby="values-h">
  <h2 id="values-h" class="sr-only">{{.T "about.values.heading"}}</h2>
  <div class="about-values">
    <div class="about-value">
      <svg class="about-value__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
      <h3 class="about-value__title">{{.T "about.values.free.title"}}</h3>
      <p>{{.T "about.values.free.body"}}</p>
    </div>
    <div class="about-value">
      <svg class="about-value__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></svg>
      <h3 class="about-value__title">{{.T "about.values.open.title"}}</h3>
      <p>{{.T "about.values.open.body"}}</p>
    </div>
    <div class="about-value">
      <svg class="about-value__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M2 20c0-3 3-5 6-5s6 2 6 5M12 20c0-3 3-5 6-5s4 1 4 3"/></svg>
      <h3 class="about-value__title">{{.T "about.values.community.title"}}</h3>
      <p>{{.T "about.values.community.body"}}</p>
    </div>
    <div class="about-value">
      <svg class="about-value__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
      <h3 class="about-value__title">{{.T "about.values.private.title"}}</h3>
      <p>{{.T "about.values.private.body"}}</p>
    </div>
    <div class="about-value">
      <svg class="about-value__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/></svg>
      <h3 class="about-value__title">{{.T "about.values.phone.title"}}</h3>
      <p>{{.T "about.values.phone.body"}}</p>
    </div>
  </div>
</section>

<section class="about-section" id="goals" aria-labelledby="goals-h">
  <h2 id="goals-h">{{.T "about.goals.heading"}}</h2>
  <ol class="about-goals">
    <li><div><strong>{{.T "about.goals.local.title"}}</strong><span>{{.T "about.goals.local.body"}}</span></div></li>
    <li><div><strong>{{.T "about.goals.honest.title"}}</strong><span>{{.T "about.goals.honest.body"}}</span></div></li>
    <li><div><strong>{{.T "about.goals.reuse.title"}}</strong><span>{{.T "about.goals.reuse.body"}}</span></div></li>
  </ol>
</section>

<section class="about-section" id="start" aria-labelledby="start-h">
  <h2 id="start-h">{{.T "about.start.heading"}}</h2>
  <p>{{.T "about.start.intro"}}</p>
  <h3 id="start-read" class="about-group">{{.T "about.start.group.read.title"}}</h3>
  <ol class="about-steps">
    {{template "about-step" (.Step "layers")}}
    {{template "about-step" (.Step "metrics")}}
    {{template "about-step" (.Step "legend")}}
    {{template "about-step" (.Step "window")}}
    {{template "about-step" (.Step "inactive")}}
  </ol>
  <h3 id="start-find" class="about-group">{{.T "about.start.group.find.title"}}</h3>
  <ol class="about-steps">
    {{template "about-step" (.Step "search")}}
    {{template "about-step" (.Step "areas")}}
    {{template "about-step" (.Step "below")}}
    {{template "about-step" (.Step "phone")}}
  </ol>
  <h3 id="start-move" class="about-group">{{.T "about.start.group.move.title"}}</h3>
  <ol class="about-steps">
    {{template "about-step" (.Step "tilt")}}
    {{template "about-step" (.Step "locate")}}
  </ol>
  <h3 id="start-layers" class="about-group">{{.T "about.start.group.layers.title"}}</h3>
  <ol class="about-steps">
    {{template "about-step" (.Step "pollen")}}
    {{template "about-step" (.Step "sea")}}
    {{template "about-step" (.Step "wind")}}
    {{template "about-step" (.Step "official")}}
  </ol>
  <h3 id="start-history" class="about-group">{{.T "about.start.group.history.title"}}</h3>
  <ol class="about-steps">
    {{template "about-step" (.Step "replay")}}
    {{template "about-step" (.Step "charts")}}
  </ol>
  <h3 id="start-keep" class="about-group">{{.T "about.start.group.keep.title"}}</h3>
  <ol class="about-steps">
    {{template "about-step" (.Step "favourite")}}
    {{template "about-step" (.Step "share")}}
    {{template "about-step" (.Step "embed")}}
    {{template "about-step" (.Step "table")}}
  </ol>
</section>

<section class="about-section" id="privacy" aria-labelledby="privacy-h">
  <h2 id="privacy-h">{{.T "about.privacy.heading"}}</h2>
  <div class="about-promise">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
    <p>{{.T "about.privacy.intro"}}</p>
  </div>
  {{template "privacyStorage" .}}
</section>

<section class="about-section" id="visitors" aria-labelledby="visitors-h">
  <h2 id="visitors-h">{{.T "about.visitors.heading"}}</h2>
  <p>{{.T "about.visitors.intro"}}</p>
  <div class="about-stats">
    <h3 class="about-stats__title">{{.T "about.visitors.chart_title"}}</h3>
    <div class="about-stats__chart" data-island="visitors" role="img" aria-label="{{.T "about.visitors.label"}}"
         data-t-title="{{.T "about.visitors.chart_title"}}" data-t-date="{{.T "about.visitors.date"}}"
         data-t-empty="{{.T "about.visitors.empty"}}" data-t-unavailable="{{.T "about.visitors.unavailable"}}"></div>
    <p class="about-stats__note">{{.T "about.visitors.note"}}</p>
  </div>
</section>

<section class="about-section" id="station" aria-labelledby="station-h">
  <h2 id="station-h">{{.T "about.station.heading"}}</h2>
  <p>{{.T "about.station.body"}}</p>
  <div class="about-cards">
    <div class="about-card">
      <svg class="about-card__ill" viewBox="0 0 160 112" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="20" y="22" width="76" height="68" rx="8" class="ill-fill"/><circle cx="58" cy="56" r="22" class="ill-warn"/><path d="M58 56l0-14M58 56l12 7M58 56l-12 7" class="ill-blade"/><circle cx="58" cy="56" r="3" class="ill-dot"/><rect x="108" y="48" width="36" height="42" rx="4" class="ill-fill"/><path d="M116 60h20M116 70h12" stroke-linecap="round"/><circle cx="136" cy="80" r="3" class="ill-dot"/><path d="M96 70h12" stroke-linecap="round"/></svg>
      <h3 class="about-card__title"><a href="https://airbg.info/naprawi-si-stancia" rel="noopener noreferrer">{{.T "about.station.build"}}</a></h3>
      <span class="about-card__desc">{{.T "about.station.build.desc"}}</span>
    </div>
    <div class="about-card">
      <svg class="about-card__ill" viewBox="0 0 160 112" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M24 54L80 16l56 38" stroke-linecap="round"/><path d="M36 48v50h88V48" class="ill-fill"/><rect x="68" y="70" width="24" height="28" rx="2"/><rect x="100" y="56" width="18" height="14" rx="3" class="ill-warn"/><circle cx="109" cy="63" r="3" class="ill-dot"/><path d="M44 98h72" stroke-linecap="round"/></svg>
      <h3 class="about-card__title"><a href="https://airbg.info/zaqwi-uchastie" rel="noopener noreferrer">{{.T "about.station.adopt"}}</a></h3>
      <span class="about-card__desc">{{.T "about.station.adopt.desc"}}</span>
    </div>
    <div class="about-card">
      <svg class="about-card__ill" viewBox="0 0 160 112" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M28 30l16-9 16 9v18l-16 9-16-9zM60 30l16-9 16 9v18l-16 9-16-9zM92 30l16-9 16 9v18l-16 9-16-9zM44 57l16-9 16 9v18l-16 9-16-9zM76 57l16-9 16 9v18l-16 9-16-9zM28 84l16-9 16 9v18M60 84l16-9 16 9v18" class="ill-fill"/><path d="M92 14c-9 0-15 6-15 14 0 10 15 26 15 26s15-16 15-26c0-8-6-14-15-14z" class="ill-warn"/><circle cx="92" cy="28" r="5" class="ill-dot"/></svg>
      <h3 class="about-card__title"><a href="https://maps.sensor.community" rel="noopener noreferrer">{{.T "about.station.map"}}</a></h3>
      <span class="about-card__desc">{{.T "about.station.map.desc"}}</span>
    </div>
  </div>
  <p class="about-card__note">{{range .AboutNoteParts}}{{if .Href}}<a href="{{.Href}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}</p>
</section>

<section class="about-section" id="involved" aria-labelledby="involved-h">
  <h2 id="involved-h">{{.T "about.involved.heading"}}</h2>
  {{/* The sentence carries {repo} and {issues}; InvolvedParts splits it so the links are real anchors and every run is escaped text. */}}
  <p>{{range .InvolvedParts}}{{if .Href}}<a href="{{.Href}}" rel="noopener noreferrer">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}</p>
</section>

<section class="about-section" id="more" aria-labelledby="more-h">
  <h2 id="more-h">{{.T "about.more.heading"}}</h2>
  <div class="about-links">
    <a href="{{.Path "/about-the-data"}}"><svg class="about-links__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/><path d="M9 8h7"/></svg><span class="about-links__go" aria-hidden="true">→</span><strong>{{.T "about.more.data.title"}}</strong><span>{{.T "about.more.data.body"}}</span></a>
    <a href="{{.SourceRepoURL}}" rel="noopener noreferrer"><svg class="about-links__icon" viewBox="0 0 16 16" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span class="about-links__go" aria-hidden="true">↗</span><strong>{{.T "about.more.code.title"}}</strong><span>{{.T "about.more.code.body"}}</span></a>
    <a href="{{.SourceRepoURL}}/blob/master/CONTRIBUTING.md" rel="noopener noreferrer"><svg class="about-links__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="5.5" r="2.5"/><circle cx="6" cy="18.5" r="2.5"/><circle cx="18" cy="18.5" r="2.5"/><path d="M6 8v8M18 16V9a3 3 0 0 0-3-3h-3"/><path d="M14.5 3.5L12 6l2.5 2.5"/></svg><span class="about-links__go" aria-hidden="true">↗</span><strong>{{.T "about.more.contribute.title"}}</strong><span>{{.T "about.more.contribute.body"}}</span></a>
  </div>
</section>

<p class="about-back"><a href="{{.Path "/"}}">{{.T "area.back_to_map"}}</a></p>
</div>
{{end}}

{{/* One Getting started card. Data is PageData plus .Name, from PageData.Step. */}}
{{define "about-step"}}<li>
  <div class="about-step__text">
    <h4>{{.T (printf "about.start.%s.title" .Name)}}</h4>
    <p>{{.T (printf "about.start.%s.body" .Name)}}</p>
  </div>
  <figure class="about-shot">
    <img class="about-shot__img about-shot__img--light" src="{{.Static (printf "about/start-%s-%s-light.webp" .Name .Lang)}}" alt="{{.T (printf "about.start.%s.alt" .Name)}}" width="560" height="460" loading="lazy" decoding="async">
    <img class="about-shot__img about-shot__img--dark" src="{{.Static (printf "about/start-%s-%s-dark.webp" .Name .Lang)}}" alt="{{.T (printf "about.start.%s.alt" .Name)}}" width="560" height="460" loading="lazy" decoding="async">
  </figure>
  {{if eq .Name "embed"}}<div class="about-step__extra">
    {{/* The real form: /embed takes a province slug only (docs/embedding.md). */}}
    <div class="about-code-wrap" data-island="copycode" data-t-copy="{{.T "about.start.embed.copy"}}" data-t-copied="{{.T "about.start.embed.copied"}}" data-t-failed="{{.T "panel.copy_failed"}}">
    <pre class="about-code" dir="ltr" tabindex="0" role="region" aria-label="{{.T "about.start.embed.code_label"}}"><code>&lt;iframe src="{{.BaseURL}}/embed?area=plovdiv-oblast"
        title="{{.T "seo.title_brand"}}" width="100%" height="480"
        loading="lazy" style="border:0"&gt;&lt;/iframe&gt;</code></pre>
    </div>
    <p><a href="{{.SourceRepoURL}}/blob/master/docs/embedding.md" rel="noopener">{{.T "about.start.embed.docs"}}</a></p>
  </div>{{end}}
</li>{{end}}

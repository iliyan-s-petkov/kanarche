{{/* Mostly static prose — everything up to the privacy section is a property
     of the data that does not change between requests. It is also the one
     page that must render when there is no snapshot — see handleAbout — so it
     may not depend on .Areas or .Area. The privacy section's one island (the
     "clear my settings" button) is the exception: it needs JavaScript to do
     anything, and degrades to a plain, inert button without it. */}}
{{define "main"}}
{{/* Prose, so .measure and not .frame: this page is read, not scanned. */}}
<div class="measure">
<div class="page-head">
  <h1 class="t-title">{{.T "about.title"}}</h1>
  <p class="t-body">{{.T "about.intro"}}</p>
</div>

<h2>{{.T "about.reference.heading"}}</h2>
<p>{{.T "about.reference.body"}}</p>

<h2>{{.T "about.sensors.heading"}}</h2>
<p>{{.T "about.sensors.body"}}</p>

<h2>{{.T "about.cities.heading"}}</h2>
<p>{{.T "about.cities.body"}}</p>
<p>{{.T "about.cities.list"}}</p>
<p>{{.T "about.cities.reading"}}</p>

<h2>{{.T "about.coverage.heading"}}</h2>
<p>{{.T "about.coverage.body"}}</p>

<h2>{{.T "about.borders.heading"}}</h2>
<p>{{.T "about.borders.body"}}</p>

<h2>{{.T "about.sources.heading"}}</h2>
<p>{{.T "about.sources.body"}}</p>

<h2>{{.T "about.privacy.heading"}}</h2>
{{template "privacyStorage" .}}

<p><a href="{{.Path "/"}}">{{.T "area.back_to_map"}}</a></p>
</div>
{{end}}

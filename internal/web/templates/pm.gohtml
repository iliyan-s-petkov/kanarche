{{/* /pm25 and /pm10: static explainers. Copy is owner-approved; band edges are filled from the EAQI tables. */}}
{{define "main"}}
<div class="measure">
<nav class="breadcrumb" aria-label="{{.T "area.breadcrumb.label"}}">
<a class="link" href="{{.Path "/"}}">{{.T "area.breadcrumb.home"}}</a><span class="breadcrumb__sep" aria-hidden="true">›</span><span aria-current="page">{{.T (printf "%s.h1" .PM.Key)}}</span>
</nav>
<div class="page-head">
  <h1 class="t-title">{{.T (printf "%s.h1" .PM.Key)}}</h1>
  <p class="t-body">{{.T (printf "%s.intro" .PM.Key)}}</p>
</div>

<h2>{{.T (printf "%s.what.heading" .PM.Key)}}</h2>
<p>{{.T (printf "%s.what.body" .PM.Key)}}</p>

<h2>{{.T (printf "%s.sources.heading" .PM.Key)}}</h2>
<p>{{.T (printf "%s.sources.body" .PM.Key)}}</p>

<h2>{{.T (printf "%s.health.heading" .PM.Key)}}</h2>
<p>{{.T (printf "%s.health.body" .PM.Key)}}</p>

<h2>{{.T (printf "%s.bands.heading" .PM.Key)}}</h2>
<p>{{.PM.Bands}}</p>
<p>{{.T (printf "%s.who.body" .PM.Key)}}</p>

<h2>{{.T "guide.measure.heading"}}</h2>
<p>{{.T "guide.measure.body"}}</p>

<h2>{{.T "guide.high.heading"}}</h2>
<p>{{.T "guide.high.body"}}</p>

<h2>{{.T "guide.links.heading"}}</h2>
<ul>
  <li><a class="link" href="{{.Path "/"}}">{{.T "guide.links.map"}}</a></li>
  <li><a class="link" href="{{.Path "/areas"}}">{{.T "guide.links.areas"}}</a></li>
  <li><a class="link" href="{{.PM.OtherPath}}">{{.T .PM.OtherKey}}</a></li>
  <li><a class="link" href="{{.Path "/about-the-data"}}">{{.T "guide.links.about"}}</a></li>
  <li><a class="link" href="https://www.eea.europa.eu/en/topics/in-depth/air-pollution" rel="noopener">{{.T "guide.links.official"}}<span aria-hidden="true"> ↗</span></a></li>
</ul>
</div>
{{end}}

{{define "main"}}
{{/* .frame, not .measure: this page carries a map and a chart, which need the
     data width. Slice D gives it the kit's .readouts and .map--wide; the
     container is what it needs now that <main> no longer clamps anything. */}}
<div class="frame">
{{template "breadcrumb" .}}

{{/* The kit's .page-head: the name, then whatever qualifies it, above the
     figures rather than between them. */}}
<div class="page-head">
<h1 class="t-title">{{.AreaHeading}}</h1>
{{with .AreaChip}}<div class="area-chips">
  <span class="area-chips__metric">{{.Label}}</span>
  <span class="area-chips__value">{{.Value}}{{with .Unit}} <span class="area-chips__unit"{{if $.AreaChip.UnitSpoken}} aria-hidden="true"{{end}}>{{.}}</span>{{end}}{{with .UnitSpoken}}<span class="visually-hidden"> {{.}}</span>{{end}}</span>
  {{if .Band}}<span class="chip"><svg class="chip__dot" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="6.5" fill="{{.BandColour}}" stroke="currentColor"></circle></svg>{{.Band}}</span>{{end}}
</div>
{{end}}
{{/* Shown on city pages only, because this is the page where the misreading
     happens: a reader comparing two cities has no way to know that 14 of the
     27 are whole municipalities and the rest are the city proper. It is
     unconditional across cities rather than shown only for the 14, because
     nothing in the data marks which is which — the split is a property of
     OpenStreetMap's tagging, recorded in docs/known-limitations.md, not a
     column. Naming the counts keeps the sentence honest for both halves.

     Above the strip, not below it: it changes how every figure in the strip
     should be read, and a caveat printed after the numbers arrives too late. */}}
{{if eq .Area.Kind "city"}}
<p class="notice-inline">{{.T "area.city_boundary_note"}}
  <a href="{{.Path "/about-the-data"}}">{{.T "about.title"}}</a></p>
{{end}}
</div>

{{/* The air-now and 24h sentences: first text a reader and a crawler meet,
     and what the page's title already promised ("сега"). Server HTML, no
     island — JS never rewrites it, and the sentence's own <time datetime>
     keeps a page left open honest after the map refreshes underneath it.
     Touch phones show it below the map (app.css) to keep the pull tab above the fold. */}}
<div class="area-summary">
{{.AreaNowHTML}}
<p class="area-summary__note">{{.T "area.indicative"}}</p>
{{.AreaDayHTML}}
</div>

{{if not .Area.Covered}}
  <div class="notice">
    <p><strong>{{.T "area.no_coverage"}}</strong></p>
    <p>{{.T "area.no_coverage_detail"}}</p>
  </div>
{{end}}

{{/* Desktop DOM order: readings and health guidance come before the map. Phones lift the map above them (app.css). */}}
<div class="area-now-block">
{{if .AreaReadouts}}<section class="area-now-section" aria-labelledby="area-now-h">
<h2 id="area-now-h" class="readouts__title">{{.T "period.now"}}</h2>
<p class="readouts__sub">{{.AreaReadoutsSub}}</p>
{{template "readouts-island" .}}
</section>{{else}}{{template "readouts-island" .}}{{end}}
{{.AreaHealthHTML}}
</div>

{{/* One toolbar row above the map: metric picker, status filter, count, and the pollen chip last.
     The sensor bar is covered areas only: with no recent readings every sensor is silent and the
     filter would offer a choice between everything and nothing. Not server-rendered, the counts
     come from the sensor payload the map fetches. */}}
<h2 id="area-map-h" class="area-map-h">{{.T "map.label"}}</h2>
<div class="toolbar toolbar--map">
<div data-island="switcher"
     data-metrics="{{.MetricsAttr}}"
     data-metric-labels="{{.MetricLabelsAttr}}"
     data-metric="{{.DefaultMetric}}"
     data-t-legend="{{.T "metric.legend"}}"></div>
{{if .Area.Covered}}
<div data-island="sensorbar"
       data-metrics="{{.MetricsAttr}}"
       data-metric="{{.DefaultMetric}}"
       data-t-legend="{{.T "sensor.legend"}}"
       data-t-all="{{.T "sensor.all"}}"
       data-t-active="{{.T "sensor.active"}}"
       data-t-inactive="{{.T "sensor.inactive"}}"
       data-t-shown="{{.T "sensor.meta.shown"}}"
       data-t-of="{{.T "sensor.meta.of"}}"
       data-t-sensors="{{.T "sensor.meta.sensors"}}"
       data-t-silent="{{.T "sensor.meta.silent"}}"></div>
{{end}}
{{with .AreaPollen}}{{if .Chip}}<a class="pollen-chip" href="#pollen">{{.Chip}}</a>{{end}}{{end}}
</div>

{{/* The shell is the positioning context for the on-map key, and it is a
     wrapper rather than the map itself because below 672px the kit moves the
     key out from over the map to under it — and inside .map, "under the map"
     is still over the map's own bottom corner. No .map--hero here, so the
     shell takes no width cap: the country fit is 926/382 and a province
     window is 926/560 (see --map-view-h in components.css). */}}
<div class="map-shell">
{{/* A map is a region with a name, not an unlabelled box: D4 found it
     announced only as "Map". The description points at the sensor table
     below the map (areaSensors), which carries the same readings as text. */}}
{{/* .map--wide is the kit's area-page map: full width of the frame, and a
     container-type so anything inside it can size itself against the map
     rather than against the viewport. */}}
<div id="area-map" data-island="map" class="data-frame map map--wide"
     role="region" aria-label="{{.T "map.label"}}"
     aria-describedby="area-map-alt"
     data-slug="{{.Area.Slug}}"
     data-zoom="{{.Area.Zoom}}"
     data-lon="{{.Area.Lon}}"
     data-lat="{{.Area.Lat}}"
     data-metric="{{.DefaultMetric}}"
     data-metrics="{{.MetricsAttr}}"
     data-metric-labels="{{.MetricLabelsAttr}}"
     data-metric-units="{{.MetricUnitsAttr}}"
     data-basemap="{{.BasemapStyleURL}}"
     data-lang-prefix="{{.LangPrefix}}"
     data-no-data-colour="{{.NoDataColour}}"
     data-unscaled-colour="{{.UnscaledColour}}"
     data-marker-stroke-colour="{{.MarkerStrokeColour}}"
     data-hex-opacity="{{.HexOpacity}}"
     data-marker-label-colour="{{.MarkerLabelColour}}"
     data-empty-basemap-colour="{{.EmptyBasemapColour}}"
     data-zoom-city="{{.ZoomCity}}"
     data-zoom-sensor="{{.ZoomSensor}}"
     data-t-legend="{{.T "map.legend.title"}}"
     data-t-legend-toggle="{{.T "map.legend.toggle"}}"
     data-t-legend-no-data="{{.T "map.legend.no_data"}}"
     data-t-legend-wind="{{.T "map.legend.wind"}}"
     data-t-legend-about="{{.T "map.legend.about"}}"
     data-t-legend-bands="{{.T "map.legend.bands_label"}}"
     data-t-scale-title="{{.T "scale.dialog.title"}}"
     data-t-scale-unit="{{.T "scale.dialog.unit"}}"
     data-t-scale-dismiss="{{.T "scale.dialog.dismiss"}}"
     data-t-range-up-to="{{.T "scale.range.up_to"}}"
     data-t-range-between="{{.T "scale.range.between"}}"
     data-t-range-above="{{.T "scale.range.above"}}"
     data-t-legend-source="{{.T "map.legend.source"}}"
     data-t-disclaimer="{{.T "disclaimer"}}"
     data-t-close="{{.T "panel.close"}}"
     data-t-tier-country="{{.T "map.legend.tier.country"}}"
     data-t-tier-city="{{.T "map.legend.tier.city"}}"
     data-t-tier-sensors="{{.T "map.legend.tier.sensors"}}"
     data-t-fullscreen="{{.T "map.fullscreen"}}"
     data-t-fullscreen-exit="{{.T "map.fullscreen.exit"}}"
     data-t-sheet-history="{{.T "map.sheet.history"}}"
     data-t-panel-history="{{.T "map.panel.history"}}"
     data-t-panel-history-short="{{.T "map.panel.history_short"}}"
     data-t-panel-area-below="{{.T "map.panel.area_below"}}"
     data-t-panel-area-below-unnamed="{{.T "map.panel.area_below_unnamed"}}"
     data-t-panel-fold="{{.T "map.panel.fold"}}"
     data-t-panel-resize="{{.T "map.panel.resize"}}"
     data-t-panel-expand="{{.T "map.panel.expand"}}"
     data-t-address-pin="{{.T "find.address_pin"}}"
     data-t-zoom-in="{{.T "map.zoom.in"}}"
     data-t-zoom-out="{{.T "map.zoom.out"}}"
     data-t-zoom-reset="{{.T "map.zoom.reset"}}"
     data-t-orient-label="{{.T "map.orient.label"}}"
     data-t-orient-tip="{{.T "map.orient.tip"}}"
     data-t-orient-tilt="{{.T "map.orient.tilt"}}"
     data-t-orient-heading="{{.T "map.orient.heading"}}"
     data-t-orient-north="{{.T "map.orient.north"}}"
     {{template "mapLayerLabels" .}}
     data-t-hint="{{.T "map.hint.select_area"}}"
     data-t-no-sources="{{.T "map.hint.no_sources"}}"
     data-t-rate-limited="{{.T "map.error.rate_limited"}}"
     data-t-unavailable="{{.T "map.error.unavailable"}}"
     data-t-unscaled="{{.T "metric.unscaled"}}"
     data-t-locate-button="{{.T "locate.button"}}"
     data-t-locate-hint="{{.T "locate.hint"}}"
     data-t-locate-denied="{{.T "locate.denied"}}"
     data-t-locate-failed="{{.T "locate.failed"}}"
     data-t-wind-toggle="{{.T "wind.toggle"}}"
     data-t-wind-about="{{.T "wind.about"}}"
     data-t-wind-note="{{.T "wind.note"}}"
     data-t-wind-attribution="{{.T "wind.attribution"}}"
     data-t-wind-credit="{{.T "wind.credit"}}"
     data-sea-colours="{{.SeaClassColours}}"
     data-sea-credit-url="{{.AttributionURL "eea-bathing"}}"
     data-pollen-credit-url="{{.AttributionURL "open-meteo"}}"
     data-t-pollen-toggle="{{.T "pollen.species"}}"
     data-t-pollen-legend="{{.T "pollen.title"}}"
     data-t-pollen-credit="{{.T "pollen.credit"}}"
     data-t-pollen-level-low="{{.T "pollen.level.low"}}"
     data-t-pollen-level-moderate="{{.T "pollen.level.moderate"}}"
     data-t-pollen-level-high="{{.T "pollen.level.high"}}"
     data-t-pollen-info-label="{{.T "pollen.info.label"}}"
     data-t-pollen-info-title="{{.T "pollen.info.title"}}"
     data-t-pollen-info-body="{{.T "pollen.info.body"}}"
     data-t-pollen-info-mean="{{.T "pollen.info.hourly"}}"
     data-t-pollen-info-link-thresholds="{{.T "pollen.info.link_thresholds"}}"
     data-t-pollen-info-link-chart="{{.T "pollen.info.link_chart"}}"
     data-t-sea-toggle="{{.T "sea.toggle"}}"
     data-t-sea-legend="{{.T "sea.legend"}}"
     data-t-sea-class-excellent="{{.T "sea.class.excellent"}}"
     data-t-sea-class-good="{{.T "sea.class.good"}}"
     data-t-sea-class-sufficient="{{.T "sea.class.sufficient"}}"
     data-t-sea-class-poor="{{.T "sea.class.poor"}}"
     data-t-sea-class-not-classified="{{.T "sea.class.not_classified"}}"
     data-t-sea-class-good-or-sufficient="{{.T "sea.class.good_or_sufficient"}}"
     data-t-sea-zone-coastal="{{.T "sea.zone.coastal"}}"
     data-t-sea-zone-lake="{{.T "sea.zone.lake"}}"
     data-t-sea-season="{{.T "sea.season"}}"
     data-t-sea-history="{{.T "sea.history"}}"
     data-t-sea-samples="{{.T "sea.samples"}}"
     data-t-sea-date="{{.T "sea.date"}}"
     data-t-sea-e-coli="{{.T "sea.e_coli"}}"
     data-t-sea-enterococci="{{.T "sea.enterococci"}}"
     data-t-sea-unit="{{.T "sea.unit"}}"
     data-t-sea-limits="{{.T "sea.limits"}}"
     data-t-sea-over-excellent="{{.T "sea.over_excellent"}}"
     data-t-sea-over-good="{{.T "sea.over_good"}}"
     data-t-sea-below-detection="{{.T "sea.below_detection"}}"
     data-t-sea-pre-season="{{.T "sea.pre_season"}}"
     data-t-sea-no-samples="{{.T "sea.no_samples"}}"
     data-t-sea-note="{{.T "sea.note"}}"
     data-t-sea-credit="{{.T "sea.credit"}}"
     data-t-sea-profile="{{.T "sea.profile"}}"
     data-t-sea-close="{{.T "sea.close"}}"
     data-t-sea-failed="{{.T "sea.failed"}}"
     data-t-sea-info-label="{{.T "sea.info.label"}}"
     data-t-sea-info-title="{{.T "sea.info.title"}}"
     data-t-sea-info-body="{{.T "sea.info.body"}}"
     data-t-sea-info-rzi="{{if .RZIEnabled}}{{.T "sea.info.rzi"}}{{end}}"
     data-t-sea-new-tab="{{.T "common.new_tab"}}"
     data-t-sea-info-link-map="{{.T "sea.info.link_map"}}"
     data-t-sea-info-link-eea="{{.T "sea.info.link_eea"}}"
     data-t-sea-info-link-datahub="{{.T "sea.info_link_datahub"}}"
     data-t-sea-class-source-datahub="{{.T "sea.class_source_datahub"}}"
     data-t-sea-samples-pending="{{.T "sea.samples_pending"}}"
     data-t-sea-supplement-note="{{.T "sea.supplement_note"}}"
     data-t-sea-latest-heading="{{.T "sea.latest.heading"}}"
     data-t-sea-latest-single-sample-note="{{.T "sea.latest.single_sample_note"}}"
     data-t-sea-latest-stale="{{.T "sea.latest.stale"}}"
     data-t-sea-latest-off-season="{{.T "sea.latest.off_season"}}"
     data-t-sea-credit-rzi="{{.T "sea.credit.rzi"}}"
     data-t-sea-notice-unofficial="{{.T "sea.notice.unofficial"}}"
     data-t-sea-source-rzi-varna="{{.T "sea.source.rzi_varna"}}"
     data-t-sea-source-rzi-burgas="{{.T "sea.source.rzi_burgas"}}"
     data-t-sea-source-rzi-dobrich="{{.T "sea.source.rzi_dobrich"}}"
     data-t-sea-source-link="{{.T "sea.source.link"}}"
     data-t-sea-unit-mpn="{{.T "sea.unit.mpn"}}"
     data-t-sea-initial-excellent="{{.T "sea.initial.excellent"}}"
     data-t-sea-initial-good="{{.T "sea.initial.good"}}"
     data-t-sea-initial-sufficient="{{.T "sea.initial.sufficient"}}"
     data-t-sea-initial-poor="{{.T "sea.initial.poor"}}"
     data-t-sea-official-class="{{.T "sea.official_class"}}"
     data-t-sea-chips-heading="{{.T "sea.chips.heading"}}"
     data-t-sea-chips-key-within="{{.T "sea.chips.key_within"}}"
     data-t-sea-chips-none="{{.T "sea.chips.none"}}"
     data-t-sea-chips-info-label="{{.T "sea.chips.info_label"}}"
     data-t-sea-seasons-since="{{.T "sea.seasons_since"}}"
     data-t-sea-details="{{.T "sea.details"}}"
     data-t-sea-back="{{.T "sea.back"}}"
     data-t-sea-tabs-label="{{.T "sea.tabs.label"}}"
     data-t-sea-tabs-samples="{{.T "sea.tabs.samples"}}"
     data-t-sea-tabs-seasons="{{.T "sea.tabs.seasons"}}"
     data-t-sea-tabs-about="{{.T "sea.tabs.about"}}"
     data-t-sea-metric-label="{{.T "sea.metric.label"}}"
     data-t-sea-season-picker="{{.T "sea.season_picker"}}"
     data-t-sea-chart-summary="{{.T "sea.chart.summary"}}"
     data-t-sea-chart-caption="{{.T "sea.chart.caption"}}"
     data-t-sea-chart-show-table="{{.T "sea.chart.show_table"}}"
     data-t-sea-chart-show-chart="{{.T "sea.chart.show_chart"}}"
     data-t-sea-chart-band-within="{{.T "sea.chart.band_within"}}"
     data-t-sea-chart-band-between="{{.T "sea.chart.band_between"}}"
     data-t-sea-chart-band-above="{{.T "sea.chart.band_above"}}"
     data-t-sea-chart-hollow="{{.T "sea.chart.hollow"}}"
     data-t-sea-credit-source="{{.T "sea.credit.source"}}"
     data-t-sea-remark-label="{{.T "sea.rzi.remark.label"}}"
     data-t-sea-remark-credit="{{.T "sea.rzi.remark.credit"}}"
     data-t-sea-sources-eea="{{.T "sea.sources.eea"}}"
     data-t-sea-sources-info-label="{{.T "sea.sources.info_label"}}"></div>
{{/* Same overlay as the home page's: the age of the data belongs beside the
     data, and this page's partial carries the reload button too. */}}
<div class="map-freshness">{{template "dataFreshness" .}}</div>
{{template "scrollCue" .}}
</div>
{{/* Server-rendered LCP element; mountChrome adopts it (PageData.InitialTier). */}}
<p class="legend__tier map-tier">{{.InitialTier}}</p>
<p id="area-map-alt" class="visually-hidden">{{.T "map.text_alternative"}}</p>

{{/* The scroll cue's target, an empty marker: on phones it stays directly under the map (order 0) while the sections below are lifted behind it. */}}
<div id="below-map"></div>

{{/* Everything after the map: sensor card, chart, sensors, pollen, links, facts, FAQ. */}}
<div class="area-rest">

{{template "sensorCardHost" .}}

{{/* The chart: its own H2 ("История") is drawn by the island, which renders nothing while a sensor card is open. */}}
{{if .Area.Covered}}<section class="area-chart" aria-labelledby="chart-heading">
  {{/* The chart island, after the map and the card the map opens, before the
       gauges. The kit reads top-down from "where" to "how much, over time" to
       the gauges that summarise it, and a chart printed above the map answers
       a question the reader has not asked yet. It used to sit above the
       toolbar, which also put the metric switcher below the first thing that
       metric governs.

       Server-side we render nothing of the series itself —
       the numbers live behind the API so there is exactly one place that
       applies the quality filter — but the period vocabulary and the heading's
       parts are server data, so they arrive as attributes.

       data-periods is the config's own list (config.Series.PeriodNames), not a
       list written here: the API rejects any period outside it, so a hard-coded
       switcher is a button that returns 400 the day someone edits the config.
       The kit's mockup offers 6/12/24/42-hour windows, which describe a
       42-hour archive; this site keeps a year, so the kit's control is adopted
       and its options are read. */}}
  <div id="chart" data-island="chart"
       data-slug="{{.Area.Slug}}"
       data-metric="{{.DefaultMetric}}"
       {{/* The site's whole metric vocabulary, only so the chart's shared
            view-state store (see lib/viewstate.svelte.js) validates a metric
            change the same way the switcher and map islands do, whichever of
            the three happens to initialise it first. The menu below offers a
            narrower list. */}}
       data-metrics="{{.MetricsAttr}}"
       {{/* What THIS area reports — positional triples the chart's own metric
            menu reads, and re-resolves its heading label and y-axis unit
            from, so a metric change never needs a round trip. Not the global
            lists above: a menu entry for a metric this area has no sensor for
            would ask the API for a series it can never return. */}}
       data-area-metrics="{{.AreaMetricsAttr}}"
       data-area-metric-labels="{{.AreaMetricLabelsAttr}}"
       data-area-metric-units="{{.AreaMetricUnitsAttr}}"
       data-period="{{.DefaultPeriod}}"
       data-periods="{{.PeriodsAttr}}"
       data-period-labels="{{.PeriodLabelsAttr}}"
       data-line-colour="{{.ChartLineColour}}"
       {{/* The three parts of the chart's heading. Composed in the browser
            rather than server-side: the period part changes when the reader
            picks another window and the metric part when they pick another
            metric, and a pre-composed sentence could not be rewritten for
            either. */}}
       data-t-tier="{{.AreaTier}}"
       data-t-heading="{{.T "area.heading.history"}}"
       data-t-period-legend="{{.T "period.legend"}}"
       data-t-period-custom="{{.T "period.custom"}}"
       data-t-period-from="{{.T "period.from"}}"
       data-t-period-to="{{.T "period.to"}}"
       data-t-period-now="{{.T "period.now"}}"
       data-t-reset="{{.T "chart.reset"}}"
       data-t-range-invalid="{{.T "chart.range_invalid"}}"
       data-t-empty="{{.T "chart.empty"}}"
       data-t-value="{{.T "chart.axis.value"}}"
       data-t-time="{{.T "chart.axis.time"}}"
       data-t-text-summary="{{.T "chart.text.summary"}}"
       data-t-text-none="{{.T "chart.text.none"}}"
       data-t-text-caption-by-hour="{{.T "chart.text.caption_hourly"}}"
       data-t-text-caption-by-day="{{.T "chart.text.caption_daily"}}"
       {{/* Reuses map.error.unavailable rather than adding a chart-specific
            key: the sentence is generic ("data is unavailable right now") and
            a second key would have to be translated, kept in parity across
            both catalogues, and would say the same thing. */}}
       data-t-unavailable="{{.T "map.error.unavailable"}}"></div>
</section>{{end}}

{{/* Sensors: the in-view list and the full table, each a details whose summary is an H3. */}}
{{if .Area.Covered}}<section class="area-sensors-sec" aria-labelledby="sensors-h">
<h2 id="sensors-h">{{.T "area.heading.sensors"}}</h2>
{{template "nearbyList" .}}

{{/* Every sensor in the area as a table, the map's text alternative and keyboard route to
     each sensor. Filled by the map island (web/src/lib/mapareasensors.js). The static list
     inside is what crawlers and no-JS readers get, the island swaps it out once it is ready. */}}
<div class="area-sensors-host" data-area-sensors{{if not .AreaStations}} hidden{{end}}
     data-area="{{.Area.Name}}"
     {{with .AreaSensorDistricts}}data-districts="{{.}}"
     data-t-col-district="{{$.T "area.sensors.col.district"}}"{{end}}
     data-t-summary="{{.T "area.sensors.summary"}}"
     data-t-summary-one="{{.T "area.sensors.summary_one"}}"
     data-t-caption="{{.T "area.sensors.caption"}}"
     data-t-col-sensor="{{.T "area.sensors.col.sensor"}}"
     data-t-col-value="{{.T "area.sensors.col.value"}}"
     data-t-col-band="{{.T "map.legend.title"}}"
     data-t-col-updated="{{.T "area.updated"}}"
     data-t-open="{{.T "area.sensors.open"}}"
     data-t-filter="{{.T "area.sensors.filter.label"}}"
     data-t-filter-placeholder="{{.T "area.sensors.filter.placeholder"}}"
     data-t-filter-hint="{{.T "area.sensors.filter.hint"}}"
     data-t-status="{{.T "area.sensors.status"}}"
     data-t-empty="{{.T "area.sensors.empty"}}"
     data-t-none="{{.T "area.sensors.none"}}"
     data-t-range-one="{{.T "area.sensors.range_one"}}"
     data-t-no-value="{{.T "panel.no_value"}}"
     data-t-page="{{.T "table.page"}}"
     data-t-page-of="{{.T "table.page.of"}}"
     data-t-page-first="{{.T "table.page.first"}}"
     data-t-page-prev="{{.T "table.page.prev"}}"
     data-t-page-next="{{.T "table.page.next"}}"
     data-t-page-last="{{.T "table.page.last"}}"
     data-t-pager-label="{{.T "table.pager.label"}}"
     data-t-per-page="{{.T "table.perpage"}}"
     data-t-per-page-all="{{.T "table.perpage.all"}}"
     data-t-p2="{{.T "metric.P2"}}"
     data-t-p1="{{.T "metric.P1"}}"
     data-t-unit-p2="{{.T "unit.P2"}}"
     data-t-unit-p1="{{.T "unit.P1"}}"
     {{template "bandLabels" .}}>
{{with .AreaStations}}<details class="area-sensors area-sensors--static" data-area-sensors-static>
  <summary><h3 class="sensors-h3">{{.Summary $}}</h3></summary>
  <div class="area-sensors__scroll">
    <table class="table area-sensors__table">
      <caption>{{.Caption $}}</caption>
      <thead><tr>
        <th scope="col">{{$.T "area.sensors.col.sensor"}}</th>
        <th scope="col" class="num">{{$.T "metric.P2"}}, {{$.T "unit.P2"}}</th>
        <th scope="col" class="num">{{$.T "metric.P1"}}, {{$.T "unit.P1"}}</th>
        <th scope="col">{{$.T "area.updated"}}</th>
      </tr></thead>
      <tbody>{{range .Rows}}
        <tr><th scope="row">{{.ID}}</th><td class="num">{{.P2}}</td><td class="num">{{.P1}}</td><td>{{.Updated}}</td></tr>{{end}}
      </tbody>
    </table>
  </div>
  {{with .Capped $}}<p class="meta">{{.}}</p>{{end}}
</details>{{end}}</div>
</section>{{else}}
{{template "nearbyList" .}}
{{end}}

{{/* Pollen forecast per species and local day (PageData.AreaPollen). */}}
{{with .AreaPollen}}
<section id="pollen" class="pollen" aria-labelledby="pollen-title">
<h2 id="pollen-title">{{$.T "pollen.title"}}</h2>
<div class="pollen-scroll">
<table class="pollen-table">
<thead><tr><th scope="col">{{$.T "pollen.species"}}</th>{{range .Days}}<th scope="col"><time datetime="{{.Date}}">{{.Label}}</time></th>{{end}}</tr></thead>
<tbody>
{{range .Rows}}<tr><th scope="row">{{.Name}}</th>{{range .Cells}}{{if .Has}}<td data-level="{{.Level}}"><span class="pollen-level">{{.LevelText}}</span><span class="pollen-bar" aria-hidden="true"></span><span class="pollen-value">{{.Mean}}</span></td>{{else}}<td class="pollen-none">—<span class="visually-hidden">{{$.T "pollen.no_data"}}</span></td>{{end}}{{end}}</tr>
{{end}}</tbody>
</table>
</div>
<p class="pollen-note">{{$.T "pollen.unit_note"}} {{$.T "pollen.note"}}</p>
<p class="pollen-credit"><a class="link" href="{{$.AttributionURL "open-meteo"}}" rel="noopener noreferrer">{{$.T "pollen.credit"}}</a></p>
</section>
{{end}}

{{/* Part of / children / nearest — up to three blocks of plain links, after
     the figures rather than beside them: this is where-else, not how-much.
     No values here, just navigation; the readouts above and the province
     list already carry the numbers. */}}
{{if or .AreaParentBlock .AreaChildrenBlock .AreaNearestBlock}}
<nav class="area-links" aria-label="{{.T "area.links.label"}}">
{{with .AreaParentBlock}}
<div class="area-links__block">
<h2>{{.Label}}</h2>
<ul>{{range .Items}}<li><a class="link" href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></li>{{end}}</ul>
</div>
{{end}}
{{with .AreaChildrenBlock}}
<div class="area-links__block">
{{if .Heading}}<h2>{{.Heading}}</h2>
<p>{{.Intro}}</p>{{else}}<h2>{{.Label}}</h2>{{end}}
<ul>{{range .Items}}<li><a class="link" href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></li>{{end}}</ul>
</div>
{{end}}
{{with .AreaNearestBlock}}
<div class="area-links__block">
<h2>{{.Label}}</h2>
<ul>{{range .Items}}<li><a class="link" href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></li>{{end}}</ul>
</div>
{{end}}
</nav>
{{end}}

{{/* Native details, so it folds with no script. The JSON-LD FAQPage is built
     from these same strings (faqPage), so markup and visible text cannot differ. */}}
{{with .AreaFacts}}
<section class="area-facts" aria-labelledby="facts-heading">
<h2 id="facts-heading">{{.Heading}}</h2>
{{if .Place}}<p>{{.Place}}</p>
{{end}}{{if .Network}}<p>{{.Network}}</p>
{{end}}{{if .Rank}}<p>{{.Rank}}</p>
{{end}}</section>
{{end}}
{{with .AreaFAQ}}
<section class="faq" aria-labelledby="faq-heading">
<h2 id="faq-heading">{{.Heading}}</h2>
{{range .Items}}
<details class="faq__item">
<summary>{{.Question}}</summary>
<div class="faq__answer"><p>{{.AnswerHTML}}</p></div>
</details>
{{end}}
</section>
<p class="faq__more">{{$.AreaGeneralLine}}</p>
<p class="faq__more">{{$.AreaExplainerLine}}</p>
{{end}}
</div>
</div>
{{end}}

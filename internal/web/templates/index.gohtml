{{define "main"}}
{{/* This template serves both tabs — the map at "/" and the province list at
     "/areas" — because they render from one snapshot and one set of rows. What
     differs is which of the two is the page's subject; each tab shows its own
     and links to the other. Rendering both on the map tab made the two routes
     near-identical pages and printed the same 28 provinces twice per visit. */}}
{{$map := not (.OnPath "/areas")}}

{{if $map}}
{{/* Map-first: the map starts directly under the masthead, so the visible hero
     and the toolbar are gone. The page still needs its one h1, kept for
     assistive technology and crawlers; the controls ride on the map below. */}}
<h1 class="visually-hidden">{{.T "home.h1"}}</h1>
{{else}}
<div class="frame">
{{/* The list tab keeps its visible head and toolbar: the table is the page, not
     a map with a caption. */}}
<div class="page-head page-head--compact">
  <h1 class="t-title">{{.T "areas.h1"}}</h1>
  <h2 class="t-sub">{{.T "home.subtitle"}}</h2>
</div>
<div class="toolbar">
<div class="toolbar__spacer"></div>
{{template "finderIsland" .}}
{{/* Solid-bordered and full height, on the finder's baseline: this is where the
     list tab's controls live, so the reload belongs beside the finder rather
     than in a line of prose. */}}
<div data-island="refresh" data-t-label="{{.T "refresh.button"}}"></div>
</div>
</div>
{{end}}

{{if $map}}

{{/* The map runs full-bleed BETWEEN two contained blocks, which is why the
     .frame above closes here and another opens below rather than wrapping the
     page. The shell carries the same width cap as the map so an overlay
     anchored to the shell lands on the map's edge and not 79px off it — see
     .map-shell in components.css. */}}
<div class="map-shell">

{{/* The list below stays as the no-JavaScript fallback and as the crawlable
     content — a map alone is invisible to a search engine and unusable with
     a screen reader. The MapLibre island mounts on #map beside it, never
     replacing it. */}}
{{/* A map is a region with a name, not an unlabelled box: D4 found it
     announced only as "Map". The description points at the province list
     below, which is already the text alternative and the no-JS fallback,
     so the two are connected rather than merely both present. */}}
<div id="map" data-island="map" class="data-frame map map--hero"
     role="region" aria-label="{{.T "map.label"}}"
     aria-describedby="map-alt"
     data-remember-view="true"
     data-pollen-layer="true"
     data-zoom="{{.DefaultZoom}}" data-lon="{{.DefaultLon}}" data-lat="{{.DefaultLat}}"
     data-metric="{{.DefaultMetric}}"
     data-metrics="{{.MetricsAttr}}"
     data-metric-labels="{{.MetricLabelsAttr}}"
     data-metric-units="{{.MetricUnitsAttr}}"
     data-basemap="{{.BasemapStyleURL}}"
     data-lang-prefix="{{.LangPrefix}}"
     data-no-data-colour="{{.NoDataColour}}"
     data-unscaled-colour="{{.UnscaledColour}}"
     data-marker-stroke-colour="{{.MarkerStrokeColour}}"
     data-hex-opacity="{{.HexOpacity}}"
     data-marker-label-colour="{{.MarkerLabelColour}}"
     data-empty-basemap-colour="{{.EmptyBasemapColour}}"
     data-zoom-city="{{.ZoomCity}}"
     data-zoom-sensor="{{.ZoomSensor}}"
     data-t-legend="{{.T "map.legend.title"}}"
     data-t-legend-toggle="{{.T "map.legend.toggle"}}"
     data-t-legend-no-data="{{.T "map.legend.no_data"}}"
     data-t-legend-wind="{{.T "map.legend.wind"}}"
     data-t-legend-about="{{.T "map.legend.about"}}"
     data-t-legend-source="{{.T "map.legend.source"}}"
     data-t-disclaimer="{{.T "disclaimer"}}"
     data-t-close="{{.T "panel.close"}}"
     data-t-tier-country="{{.T "map.legend.tier.country"}}"
     data-t-tier-city="{{.T "map.legend.tier.city"}}"
     data-t-tier-sensors="{{.T "map.legend.tier.sensors"}}"
     data-t-fullscreen="{{.T "map.fullscreen"}}"
     data-t-fullscreen-exit="{{.T "map.fullscreen.exit"}}"
     data-t-sheet-history="{{.T "map.sheet.history"}}"
     data-t-panel-history="{{.T "map.panel.history"}}"
     data-t-panel-history-short="{{.T "map.panel.history_short"}}"
     data-t-panel-area-below="{{.T "map.panel.area_below"}}"
     data-t-panel-area-below-unnamed="{{.T "map.panel.area_below_unnamed"}}"
     data-t-panel-fold="{{.T "map.panel.fold"}}"
     data-t-panel-resize="{{.T "map.panel.resize"}}"
     data-t-panel-expand="{{.T "map.panel.expand"}}"
     data-t-address-pin="{{.T "find.address_pin"}}"
     data-t-zoom-in="{{.T "map.zoom.in"}}"
     data-t-zoom-out="{{.T "map.zoom.out"}}"
     data-t-zoom-reset="{{.T "map.zoom.reset"}}"
     data-t-orient-label="{{.T "map.orient.label"}}"
     data-t-orient-tip="{{.T "map.orient.tip"}}"
     data-t-orient-tilt="{{.T "map.orient.tilt"}}"
     data-t-orient-heading="{{.T "map.orient.heading"}}"
     data-t-orient-north="{{.T "map.orient.north"}}"
     {{template "mapLayerLabels" .}}
     data-t-hint="{{.T "map.hint.select_area"}}"
     data-t-no-sources="{{.T "map.hint.no_sources"}}"
     data-t-rate-limited="{{.T "map.error.rate_limited"}}"
     data-t-unavailable="{{.T "map.error.unavailable"}}"
     data-t-unscaled="{{.T "metric.unscaled"}}"
     data-t-locate-button="{{.T "locate.button"}}"
     data-t-locate-hint="{{.T "locate.hint"}}"
     data-t-locate-denied="{{.T "locate.denied"}}"
     data-t-locate-failed="{{.T "locate.failed"}}"
     data-t-wind-toggle="{{.T "wind.toggle"}}"
     data-t-wind-about="{{.T "wind.about"}}"
     data-t-wind-note="{{.T "wind.note"}}"
     data-t-wind-attribution="{{.T "wind.attribution"}}"
     data-t-wind-credit="{{.T "wind.credit"}}"
     data-sea-colours="{{.SeaClassColours}}"
     data-sea-credit-url="{{.AttributionURL "eea-bathing"}}"
     data-pollen-credit-url="{{.AttributionURL "open-meteo"}}"
     data-t-pollen-toggle="{{.T "pollen.species"}}"
     data-t-pollen-legend="{{.T "pollen.title"}}"
     data-t-pollen-credit="{{.T "pollen.credit"}}"
     data-t-pollen-level-low="{{.T "pollen.level.low"}}"
     data-t-pollen-level-moderate="{{.T "pollen.level.moderate"}}"
     data-t-pollen-level-high="{{.T "pollen.level.high"}}"
     data-t-pollen-info-label="{{.T "pollen.info.label"}}"
     data-t-pollen-info-title="{{.T "pollen.info.title"}}"
     data-t-pollen-info-body="{{.T "pollen.info.body"}}"
     data-t-pollen-info-mean="{{.T "pollen.info.hourly"}}"
     data-t-pollen-info-link-thresholds="{{.T "pollen.info.link_thresholds"}}"
     data-t-pollen-info-link-chart="{{.T "pollen.info.link_chart"}}"
     data-t-sea-toggle="{{.T "sea.toggle"}}"
     data-t-sea-legend="{{.T "sea.legend"}}"
     data-t-sea-class-excellent="{{.T "sea.class.excellent"}}"
     data-t-sea-class-good="{{.T "sea.class.good"}}"
     data-t-sea-class-sufficient="{{.T "sea.class.sufficient"}}"
     data-t-sea-class-poor="{{.T "sea.class.poor"}}"
     data-t-sea-class-not-classified="{{.T "sea.class.not_classified"}}"
     data-t-sea-class-good-or-sufficient="{{.T "sea.class.good_or_sufficient"}}"
     data-t-sea-zone-coastal="{{.T "sea.zone.coastal"}}"
     data-t-sea-zone-lake="{{.T "sea.zone.lake"}}"
     data-t-sea-season="{{.T "sea.season"}}"
     data-t-sea-history="{{.T "sea.history"}}"
     data-t-sea-samples="{{.T "sea.samples"}}"
     data-t-sea-date="{{.T "sea.date"}}"
     data-t-sea-e-coli="{{.T "sea.e_coli"}}"
     data-t-sea-enterococci="{{.T "sea.enterococci"}}"
     data-t-sea-unit="{{.T "sea.unit"}}"
     data-t-sea-limits="{{.T "sea.limits"}}"
     data-t-sea-over-excellent="{{.T "sea.over_excellent"}}"
     data-t-sea-over-good="{{.T "sea.over_good"}}"
     data-t-sea-below-detection="{{.T "sea.below_detection"}}"
     data-t-sea-pre-season="{{.T "sea.pre_season"}}"
     data-t-sea-no-samples="{{.T "sea.no_samples"}}"
     data-t-sea-note="{{.T "sea.note"}}"
     data-t-sea-credit="{{.T "sea.credit"}}"
     data-t-sea-profile="{{.T "sea.profile"}}"
     data-t-sea-close="{{.T "sea.close"}}"
     data-t-sea-failed="{{.T "sea.failed"}}"
     data-t-sea-info-label="{{.T "sea.info.label"}}"
     data-t-sea-info-title="{{.T "sea.info.title"}}"
     data-t-sea-info-body="{{.T "sea.info.body"}}"
     data-t-sea-info-link-map="{{.T "sea.info.link_map"}}"
     data-t-sea-info-link-eea="{{.T "sea.info.link_eea"}}"
     data-t-sea-info-link-datahub="{{.T "sea.info_link_datahub"}}"
     data-t-sea-class-source-datahub="{{.T "sea.class_source_datahub"}}"
     data-t-sea-samples-pending="{{.T "sea.samples_pending"}}"
     data-t-sea-supplement-note="{{.T "sea.supplement_note"}}"></div>
{{/* The controls that used to sit in a toolbar above the map: the metric pill
     top-left, beside the kit's layers button, and the place finder top-right,
     beside the full-screen button. They are siblings of #map so the map's own
     overflow cannot clip the metric menu's panel. */}}
<div class="map-controls">
<div class="map-controls__metric" data-island="switcher" data-compact
     data-metrics="{{.MetricsAttr}}"
     data-metric-labels="{{.MetricLabelsAttr}}"
     data-metric="{{.DefaultMetric}}"
     data-t-legend="{{.T "metric.legend"}}"></div>
<div class="map-controls__find">{{template "finderIsland" .}}</div>
</div>
{{/* On the map, not under it: the line says how old what you are looking at is,
     and the auto-refresh toggle governs the same thing. The manual refresh sits
     in it beside the timer (dataFreshness, data-button). */}}
<div class="map-freshness">{{template "dataFreshness" .}}</div>
{{template "scrollCue" .}}
</div>
{{/* Server-rendered LCP element; mountChrome adopts it (PageData.InitialTier). */}}
<p class="legend__tier map-tier">{{.InitialTier}}</p>
{{end}}

{{/* Contained again after the full-bleed map. Outside the tab condition
     because both tabs end inside it. */}}
<div class="frame" id="below-map">

{{if $map}}
{{/* The same panel island area.gohtml mounts, with the same attributes: the
     sensor tier is reachable from here too. refresh() (web/src/islands/map.js)
     only downgrades to the area tier when no slug is selected, and both an
     area-marker click and locateVisitor's geoip placement adopt one — so a
     visitor who clicks an area and zooms in gets clickable sensor dots on this
     page, and the click pushes #sensor=<id> exactly as it does on an area page.
     Without this container that push opened nothing and merely spent a Back
     press undoing its own hash.

     A #sensor= DEEP LINK still resolves only on an area page, and that is
     unchanged: the panel reads the sensor the map already loaded (see
     web/src/lib/sensors.svelte.js), and this page starts with no slug and
     therefore no sensor data — so a shared /#sensor=101 link renders the page
     with no panel, exactly as before. */}}
{{template "sensorCardHost" .}}


{{/* Four figures the map cannot state: it shows where, not how much overall.
     Every one is computed from the same province list rendered below (see
     PageData.Readouts), so the strip can never name a top province the list
     ranks second. Each cell carries the tier it aggregates — no bare numbers
     (DESIGN.md §9.1). */}}
{{template "readouts-island" .}}

{{/* The map's text alternative, named so aria-describedby can reach it. It is
     one sentence and a link, not a copy of the list: the list is a whole tab of
     its own, and duplicating it here is what made the two tabs the same page.
     A link rather than prose alone because this is the ONLY route a reader who
     cannot use the map has to the numbers — and it is what a crawler follows.
     Not painted: a sighted reader has the Areas tab in the nav already, and
     under the map the sentence only pointed at what was next to it. */}}
<p id="map-alt" class="visually-hidden">{{.T "map.text_alternative.areas"}}
  <a class="link" href="{{.Path "/areas"}}">{{.T "nav.areas"}}</a></p>
{{end}}

{{if not $map}}
<h2>{{.T "nav.areas"}}</h2>
{{/* The kit's .table (§5.4), not a list of flex rows: these are three facts
     about each province and a table is what says so — the column header names
     the metric and its unit once, for every row, and a screen reader announces
     it with each cell. The sentence that used to sit above the list is the
     table's <caption> now, which is the same sentence in the element that
     already means "what this table is".

     One value column, for the page's default metric — the same one the map
     paints and the same one areaRows ranks by, so the three agree without a
     second policy. The kit's mockup shows a fixed PM2.5/PM10 pair; this site
     has seven switchable metrics, and hardcoding two of them here would be a
     column that stops matching the page the moment the default changes. */}}
{{/* The table's controls mount here, above the table they act on. Empty in the
     served HTML: sorting, filtering and paging are interactive by nature, so
     none of them is rendered by the server — with no JavaScript the reader
     still gets all 28 provinces, ranked, which is the answer this page exists
     to give. The island moves its pager under the table after mounting. */}}
<div data-island="table"
     data-table=".table"
     data-meta=".meta"
     data-empty=".t-empty"
     data-t-filter-legend="{{.T "table.filter.legend"}}"
     data-t-filter-all="{{.T "table.filter.all"}}"
     data-t-filter-with-data="{{.T "table.filter.withdata"}}"
     data-t-filter-no-data="{{.T "table.filter.nodata"}}"
     data-t-per-page="{{.T "table.perpage"}}"
     data-t-per-page-all="{{.T "table.perpage.all"}}"
     data-t-pager-label="{{.T "table.pager.label"}}"
     data-t-page="{{.T "table.page"}}"
     data-t-page-of="{{.T "table.page.of"}}"
     data-t-page-first="{{.T "table.page.first"}}"
     data-t-page-prev="{{.T "table.page.prev"}}"
     data-t-page-next="{{.T "table.page.next"}}"
     data-t-page-last="{{.T "table.page.last"}}"
     data-t-shown="{{.T "table.meta.shown"}}"
     data-t-of="{{.T "table.meta.of"}}"
     data-t-areas="{{.T "table.meta.areas"}}"
     data-t-silent="{{.T "table.meta.silent"}}"
     {{/* The kit's search box inside the controls. It narrows the table rather
          than navigating, unlike the masthead finder above — hence its own
          label and hint. The "no such area" line is the finder's key, not a
          second copy of the same sentence. */}}
     data-t-search-label="{{.T "table.search.label"}}"
     data-t-search-placeholder="{{.T "table.search.placeholder"}}"
     data-t-search-hint="{{.T "table.search.hint"}}"
     data-t-search-empty="{{.T "find.no_match"}}"
     data-t-columns="{{.T "table.columns"}}"
     data-t-visible-columns="{{.T "table.visible_columns"}}"></div>

<table class="table">
  {{/* What the table holds, not what order it is in: the reader can now sort it
       by any column, and a caption that claimed a ranking would be false from
       the first click. The order is stated by aria-sort on the sorted column,
       by the caret the reader can see, and by the note below for the order the
       page arrives in. */}}
  <caption>{{.T (printf "metric.%s" .DefaultMetric)}}, {{.T (printf "unit.%s" .DefaultMetric)}}: {{.T "areas.tier"}}</caption>
  {{/* data-sort-key names the column for the table island; aria-sort states the
       order the server actually rendered, which is true with or without
       JavaScript. The headers are plain text here on purpose — the island turns
       them into buttons, because a header that looks pressable and does nothing
       is worse than a header that never claimed to be a control. */}}
  <thead>
    <tr>
      <th scope="col" data-sort-key="name">{{.T "table.col.area"}}</th>
      <th scope="col" class="num" data-sort-key="value" aria-sort="descending">{{.T (printf "metric.%s" .DefaultMetric)}}, {{.T (printf "unit.%s" .DefaultMetric)}}</th>
      <th scope="col" class="sensors" data-sort-key="sensors">{{.T "table.col.sensors"}}</th>
    </tr>
  </thead>
  <tbody>
  {{range .Areas}}
    {{/* The sort keys ride on the row rather than being parsed back out of the
         cells: the reading is printed 12,4 in Bulgarian and 12.4 in English,
         and a sort that read the text would order the table differently in the
         two languages. data-nodata is the absence itself — distinct from a
         zero, which is a legitimate reading. */}}
    <tr data-name="{{.Name}}" data-sensors="{{.SensorCount}}"{{if .HasValue}} data-value="{{printf "%.4f" .Value}}"{{else}} data-nodata{{end}}>
      <td class="name"><a class="link" href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></td>
      {{if .HasValue}}
      {{/* The swatch is an <svg> with a fill ATTRIBUTE, not the kit's
           --chip-ramp custom property: a per-row custom property is an inline
           style, and style-src has no 'unsafe-inline' — the browser drops it
           and the swatch renders empty. Same reason renderLegend draws its
           swatches this way. Omitted entirely for a metric with no band table,
           because an empty swatch would be a class the scale never claimed. */}}
      <td class="num"><span class="value-cell"><span class="chip">{{with .Colour}}<svg class="chip__swatch" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true"><rect width="1" height="1" fill="{{.}}"></rect></svg>{{end}}{{.ValueText}}</span></span></td>
      {{else}}
      {{/* Two different absences, said differently: a province with too few
           reporting sensors to publish an average at all, and one that is
           covered but has no recent reading for this metric. Muted, spanning
           nothing, no icon — an absence is not a failure (DESIGN.md §2.3). */}}
      <td class="nodata">{{if .Covered}}{{$.T "table.no_recent"}}{{else}}{{$.T "area.no_coverage"}}{{end}}</td>
      {{end}}
      <td class="sensors">{{.SensorCount}}</td>
    </tr>
  {{end}}
  </tbody>
</table>

{{/* OpenProject 609 CLS: reserved slot the table island moves its pager into. */}}
<div class="pager-slot"></div>

{{/* Where the rows would have been, when a filter leaves none. Hidden until the
     island has one to state — an empty table is a bug the reader has to
     diagnose; a sentence is information. */}}
<p class="t-empty" hidden>{{.T "table.empty"}}</p>

{{/* What the table is showing, under it. role="status" because the filter and
     the pager now change this line: a reader who cannot see the table needs to
     hear how many rows the control they just pressed left behind. */}}
<p class="meta" role="status">{{len .Areas}} {{.T "table.meta.areas"}}, {{.SilentAreas}} {{.T "table.meta.silent"}}</p>

{{/* The ordering rule, stated rather than left to be inferred from the rows:
     the list is ranked by the reading and the silent provinces sit at the end,
     which looks like alphabetical order that gave up unless it is said. */}}
<p class="table-note">{{.T "table.note"}}</p>

{{/* The province-by-province link tree (§3): 79 links a crawler and a
     no-JS reader can both follow, that the table above does not carry —
     it is ranked by reading, not organised by geography. /areas only: the
     table already serves the map tab's needs, and this section exists for
     the tab whose subject IS the list of places. */}}
{{if .Directory}}
<section aria-labelledby="areas-directory">
<h2 id="areas-directory">{{.T "areas.directory.title"}}</h2>
<p>{{.T "areas.directory.intro"}}</p>
<div class="areas-directory">
{{range .Directory}}
<div class="areas-directory__group">
<h3><a class="link" href="{{$.Path (printf "/area/%s" .Oblast.Slug)}}">{{.Label}}</a></h3>
{{if .Cities}}
<ul>
{{range .Cities}}<li><a class="link" href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></li>{{end}}
</ul>
{{end}}
{{if .Districts}}
<h4>{{$.T "area.children.districts"}}</h4>
<ul>
{{range .Districts}}<li><a class="link" href="{{$.Path (printf "/area/%s" .Slug)}}">{{.Name}}</a></li>{{end}}
</ul>
{{end}}
</div>
{{end}}
</div>
</section>
{{end}}
{{end}}
</div>
{{end}}

{{/* The finder carries no list of its own. On the list tab it reads the table
     rendered at the foot of the page, which is already the no-JS fallback; the
     map tab renders no table, so data-source is omitted there and the island
     reads the areas the map has already loaded. A pick means "show me this
     province" on both tabs: the list tab opens its page, the map tab flies to
     it, and the hint says which. */}}
{{define "finderIsland"}}{{$map := not (.OnPath "/areas")}}<div data-island="finder"
     {{if not $map}}data-source=".table tbody"{{end}}
     data-t-label="{{.T "find.label"}}"
     data-t-placeholder="{{if $map}}{{.T "find.placeholder_address"}}{{else}}{{.T "find.placeholder"}}{{end}}"
     data-t-hint="{{if $map}}{{.T "find.hint_map"}}{{else}}{{.T "find.hint"}}{{end}}"
     data-t-empty="{{.T "find.no_match"}}"
     {{if $map}}data-t-group-district="{{.T "find.group_district"}}"
     data-t-group-place="{{.T "find.group_place"}}"
     data-t-address-row="{{.T "find.address_row"}}"
     data-t-address-loading="{{.T "find.address_loading"}}"
     data-t-address-none="{{.T "find.address_none"}}"
     data-t-address-busy="{{.T "find.address_busy"}}"
     data-t-address-error="{{.T "find.address_error"}}"
     data-t-address-credit="{{.T "find.address_credit"}}"{{end}}></div>{{end}}

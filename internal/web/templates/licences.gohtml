{{/* /licences: static prose, no snapshot needed. The footer keeps the short
     attributions; the full terms and links are here. */}}
{{define "main"}}
<div class="measure">
<div class="page-head">
  <h1 class="t-title">{{.T "licences.title"}}</h1>
  <p class="t-body">{{.T "licences.intro"}}</p>
</div>

<h2>{{.T "licences.data.heading"}}</h2>
<ul class="licence-list">
  <li><strong><a href="{{.AttributionURL "sensor.community"}}" rel="noopener noreferrer">sensor.community</a></strong>: {{.T "licences.sc.what"}}. {{.T "licences.licence"}}: <a href="https://opendatacommons.org/licenses/odbl/1-0/" rel="noopener noreferrer">ODbL 1.0</a>.</li>
  <li><strong><a href="{{.AttributionURL "eea"}}" rel="noopener noreferrer">ИАОС / EEA</a></strong>: {{.T "licences.eea.what"}}. {{.T "licences.licence"}}: <a href="https://www.eea.europa.eu/en/legal-notice" rel="noopener noreferrer">{{.T "licences.eea.terms"}}</a>.</li>
  <li><strong><a href="{{.AttributionURL "open-meteo"}}" rel="noopener noreferrer">Open-Meteo</a></strong>: {{.T "licences.wind.what"}}; {{.T "licences.pollen.what"}}. {{.T "licences.licence"}}: <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer">CC BY 4.0</a>.</li>
  <li><strong><a href="{{.AttributionURL "eea-bathing"}}" rel="noopener noreferrer">{{.T "licences.bathing.name"}}</a></strong>: {{.T "licences.bathing.what"}}. {{.T "licences.licence"}}: <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer">CC BY 4.0</a>.</li>
  <li><strong><a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer">© OpenStreetMap contributors</a></strong>: {{.T "licences.osm.boundaries"}}; {{.T "licences.osm.basemap"}}. {{.T "licences.licence"}}: <a href="https://opendatacommons.org/licenses/odbl/1-0/" rel="noopener noreferrer">ODbL 1.0</a>.</li>
</ul>

<h2>{{.T "licences.code.heading"}}</h2>
<p>{{.T "licences.code.body"}} <a href="{{.SourceLicenceURL}}" rel="noopener noreferrer">{{.T "licences.code.link"}}</a>.</p>

<p><a href="{{.Path "/"}}">{{.T "area.back_to_map"}}</a></p>
</div>
{{end}}

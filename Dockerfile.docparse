# Sandbox image for cmd/rzi-extract. Pins and run flags: internal/docparse/README.md.

# Same pinned toolchain as Dockerfile.
FROM --platform=$BUILDPLATFORM golang:1.26.11@sha256:7af425da11f4fc1a9308eb704369e3f6d1c44e35bac0f874a59ade3f20fdc07e AS build
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/rzi-extract ./cmd/rzi-extract

# Test-only probe, built only for the probe target.
FROM build AS probe-build
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/netprobe ./cmd/netprobe

# Base pinned by digest; poppler-utils unpinned so Debian security revisions
# apply. The integration test holds it to the 25.x series, Trivy gates CVEs.
FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2 AS docparse
# The upgrade picks up Debian security fixes between digest bumps.
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends poppler-utils \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir /in /out
COPY --from=build /out/rzi-extract /usr/local/bin/rzi-extract
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/rzi-extract"]

# Integration tests only (I1): the docparse image plus netprobe.
FROM docparse AS probe
COPY --from=probe-build /out/netprobe /usr/local/bin/netprobe
ENTRYPOINT ["/usr/local/bin/netprobe"]

# Default target: the published image.
FROM docparse

# Two vhosts on one port, with opposite trust rules — which is exactly why the
# enforcement is a certificate and not a packet filter. A filter cannot tell
# these apart: SNI is above the layer it operates at.
#
# deploy/compose_test.go asserts the client_auth block below is present, is
# require_and_verify, and is in THIS block rather than the tiles one.

{
	email admin@kanarche.eu
}

# Since the cutover (rebrand phase 5b) both names only redirect to kanarche.eu,
# path and query untouched. One Let's Encrypt certificate, issued by certbot
# over DNS-01 outside this container, covers every name here. See README.md,
# "the origin certificate". client_auth is what closes the origin: Cloudflare's
# edge presents a certificate the public does not have, so a direct connection
# to the origin IP fails the handshake regardless of its source address.
airbg.org, www.airbg.org {
	tls /etc/caddy/tls/origin.pem /etc/caddy/tls/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/tls/cloudflare-origin-pull-ca.pem
		}
	}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# 302 keeps rollback real for the first 24-48h; change to 301 to make it permanent.
	redir https://kanarche.eu{uri} 302
}

tiles.airbg.org {
	# DNS-only (grey cloud) per docs/tiles.md: browsers connect straight here,
	# so this must NOT require a client certificate. It is served the same
	# certificate as above, which carries this name. README.md.

	@tiles_dynamic path /glyphs/* /style.json
	encode @tiles_dynamic zstd gzip

	reverse_proxy app:8082

	# The real gap without this: no edge in front, so this is the one
	# publicly-reachable TLS endpoint whose browsers get no HSTS otherwise.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# kanarche.eu is canonical since the cutover (rebrand phase 5a). Own blocks, so
# nothing here can change an airbg.org response. The certificate is the same
# lineage and carries these names too. The short HSTS goes in phase 5c.
kanarche.eu, www.kanarche.eu {
	tls /etc/caddy/tls/origin.pem /etc/caddy/tls/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/tls/cloudflare-origin-pull-ca.pem
		}
	}

	request_body {
		max_size 64KB
	}

	@static path /static/*
	encode @static zstd gzip

	reverse_proxy app:8080

	header Strict-Transport-Security "max-age=300"
}

# DNS-only like tiles.airbg.org, so no client certificate.
tiles.kanarche.eu {
	@tiles_dynamic path /glyphs/* /style.json
	encode @tiles_dynamic zstd gzip

	reverse_proxy app:8082

	header Strict-Transport-Security "max-age=300"
}

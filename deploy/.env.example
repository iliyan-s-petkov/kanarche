# Production environment for airbg.org. Copy to /srv/airbg/.env on the host,
# chmod 600, root-owned. Never commit a filled-in copy.
#
# The image carries a complete airbg.yaml; everything here is an override for
# what differs in production. There is deliberately no second config file: a
# forked airbg.prod.yaml drifts silently the day a key is added or renamed.

# The image tag to run. The git sha, so `docker ps` answers "which commit".
AIRBG_IMAGE_TAG=

# The only secret. Env-only by design: writing it into airbg.yaml is a startup
# error, not an ignored value. sslmode=disable is acceptable ONLY because this
# connection never leaves the internal compose network.
KANARCHE_DATABASE_URL=postgres://airbg:CHANGE_ME@db:5432/airbg?sslmode=disable

# Consumed by the timescaledb image; must agree with KANARCHE_DATABASE_URL.
POSTGRES_USER=airbg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=airbg

# Reachable from caddy, safe because the container publishes no port.
KANARCHE_LISTEN_ADDR=0.0.0.0:8080
# Metrics on the internal network only. Never published; read with a throwaway
# container attached to airbg_back, since the image has no shell.
KANARCHE_LISTEN_METRICS_ADDR=127.0.0.1:9090
# Canonical, hreflang and language-switcher URLs are built from this.
KANARCHE_LISTEN_BASE_URL=https://kanarche.eu
# The edge subnet — the caddy container is the direct peer. NOT Cloudflare's
# published ranges: those never appear as a peer address here, and trusting
# them would mean CF-Connecting-IP is ignored and every visitor shares one
# rate-limit bucket. compose_test.go pins this to the subnet in the compose file.
KANARCHE_LISTEN_TRUSTED_PROXY_CIDRS=172.28.0.0/24
# The shipped policy plus the tile origins (tiles.airbg.org until the redirect
# window ends). Startup FAILS if tiles.public_url is
# absent from connect-src, because a CSP-blocked fetch is a blank map and no
# server-side error anywhere. tile.openstreetmap.org is the world raster drawn
# under our Bulgaria extract and needs both img-src and connect-src.
# Lets a design-preview host on an ephemeral loopback port read the JSON API.
# Separate from the tiles switch: this surface has the rate limiters.
# Opt-in only, for local preview work — uncomment/fill in when running one.
KANARCHE_LISTEN_ALLOW_LOOPBACK_ORIGINS=false
# The OpenDesign preview's origin, and the scheme it needs declared. See
# docs/tiles.md §5e for what this grants and what it does not.
KANARCHE_LISTEN_ALLOWED_ORIGINS=
KANARCHE_LISTEN_ALLOWED_ORIGIN_SCHEMES=od
KANARCHE_LISTEN_CSP=default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://tiles.kanarche.eu https://tiles.airbg.org https://tile.openstreetmap.org; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The tiles listener, fronted by caddy on the DNS-only tiles hostname.
KANARCHE_TILES_ADDR=0.0.0.0:8082
KANARCHE_TILES_DIR=/var/lib/airbg/tiles
KANARCHE_TILES_PUBLIC_URL=https://tiles.kanarche.eu
# Regenerating the basemap MUST change this filename: responses are cached
# immutably for a year, so a reused name means returning visitors keep serving
# themselves the old map with no way to invalidate it. See docs/tiles.md.
KANARCHE_TILES_ARCHIVE=bulgaria-20260815.pmtiles
# Lets a design-preview host on an ephemeral loopback port read the basemap.
# See docs/tiles.md 5c for why this is not a secrecy relaxation.
KANARCHE_TILES_ALLOW_LOOPBACK_ORIGINS=false
# The OpenDesign preview's origin, and the scheme it needs declared. Comma
# separated. See docs/tiles.md 5e.
KANARCHE_TILES_ALLOWED_ORIGINS=
KANARCHE_TILES_ALLOWED_ORIGIN_SCHEMES=od

# The EEA official reference stations, a second selectable map network. The
# coordinate cache is a directory the container can write; the poll floor
# protects a public agency service, not our own infrastructure.
KANARCHE_EEA_ENABLED=true
KANARCHE_EEA_URL=https://eeadmz1-downloads-api-appservice.azurewebsites.net
KANARCHE_EEA_METADATA_URL=https://discomap.eea.europa.eu/map/fme/metadata/PanEuropean_metadata.csv
KANARCHE_EEA_METADATA_CACHE=/var/lib/airbg/eea
# The download host, which is not KANARCHE_EEA_URL: the API answers with blob
# storage URLs. A file offered from any other host is refused.
KANARCHE_EEA_FILE_HOSTS=eeadmz1batchservice02.blob.core.windows.net
KANARCHE_EEA_COUNTRIES=BG
KANARCHE_EEA_REQUEST_TIMEOUT=60s
KANARCHE_EEA_POLL_INTERVAL=1h
KANARCHE_EEA_MIN_POLL_INTERVAL=30m
KANARCHE_EEA_METADATA_INTERVAL=168h
KANARCHE_EEA_MAX_PAYLOAD_BYTES=67108864

# Daily unique visitors (OpenProject #591). The zone id is not secret and
# lives in airbg.yaml (cloudflare.zone_id); this token is the only secret
# this job needs. Empty is a supported value: the job logs once and does
# nothing until this is set. See internal/upstream/cloudflare/README.md for
# where the value comes from in production.
KANARCHE_CF_ANALYTICS_TOKEN=

# Address search proxy (internal/geocode). Queries are never logged. Keep in step
# with the ansible env.j2 template.
KANARCHE_GEOCODER_URL=https://nominatim.openstreetmap.org

# Footer profile links, shown only when set (https URLs). GitHub always shows.
# Keep in step with the ansible env.j2 template.
KANARCHE_SOCIAL_FACEBOOK_URL=
KANARCHE_SOCIAL_LINKEDIN_URL=
